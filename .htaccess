# Mandi 24x7 website (Hostinger shared hosting, Apache/LiteSpeed)
Options -MultiViews -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8
ErrorDocument 404 /404.php

RewriteEngine On

# 1. www.mandi24x7.com -> mandi24x7.com, and force HTTPS (only on the real domain, so local testing still works)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^mandi24x7\.com$ [NC]
RewriteRule ^ https://mandi24x7.com%{REQUEST_URI} [L,R=301]

# 2. Old file names -> the pretty URLs (e.g. /terms.html or /terms.php -> /terms)
RewriteCond %{THE_REQUEST} \s/+(privacy-policy|terms|delete-account|contact)\.(?:html|php)[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]
RewriteCond %{THE_REQUEST} \s/+index\.(?:php|html)[\s?] [NC]
RewriteRule ^ / [L,R=301]

# 3. Pretty URLs for the legal pages: the app and the store listings link to these exact paths. Never remove.
RewriteRule ^privacy-policy/?$ privacy-policy.php [L]
RewriteRule ^terms/?$ terms.php [L]
RewriteRule ^delete-account/?$ delete-account.php [L]
RewriteRule ^contact/?$ contact.php [L]

# 4. Keep internal files private (Hostinger Git deploy also puts .git/ and _old-html/ in public_html)
RewriteRule ^(includes/|config\.php$) - [F,L]
RewriteRule (^|/)(\.git|_old-html)(/|$) - [F,L]
RewriteRule ^\.git(ignore|attributes)$ - [F,L]
RewriteRule \.(md|py|bak|log)$ - [F,L]

# Types
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/manifest+json .webmanifest

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/ld+json application/manifest+json image/svg+xml image/x-icon
</IfModule>

# Browser caching (style.css and site.js are versioned with ?v=, so they can be cached long)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
